{
  "name": "seat-planner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build && node scripts/check-bundle.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "psql postgresql://postgres:postgres@127.0.0.1:55322/postgres -v ON_ERROR_STOP=1 -f supabase/tests/apply_mutation.sql && psql postgresql://postgres:postgres@127.0.0.1:55322/postgres -v ON_ERROR_STOP=1 -f supabase/tests/changes_feed.sql",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:api": "node scripts/api-smoke.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:load": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-react": "0.4.13",
    "@supabase/realtime-js": "2.118.0",
    "@supabase/supabase-js": "2.118.0",
    "konva": "10.9.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
