# Server-only values. Never prefix a secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public by design: the browser only uses these to listen to the Realtime
# "doorbell" channel (tables have no read policies, so the anon key reads nothing).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

DEMO_ROOM_ID=jsconf-mx-2026
# Empty is only accepted outside production (then any caller can become admin).
DEMO_ADMIN_PASSCODE=
# At least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# Public URL shown on the /qr page.
NEXT_PUBLIC_APP_URL=http://localhost:3000
